<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.controller.mapper.UserMapper">
    <select id="selectUser" resultType="com.example.controller.domain.UserProfile">
        SELECT *
        FROM tbl_user
        WHERE id IN
        <foreach item="id" collection="userIds" open="(" separator="," close=")">
            #{userIds}
        </foreach>
    </select>
</mapper>